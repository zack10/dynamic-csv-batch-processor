{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/csv-blueprint/v1/schema.json",
  "title": "CSV replacement blueprint version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "input", "mappings"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "delimiter", "quote", "escapeMode", "header", "ignoreEmptyRecords"],
      "properties": {
        "encoding": {"type": "string", "minLength": 1},
        "delimiter": {"type": "string", "minLength": 1, "maxLength": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 1},
        "escapeMode": {"const": "doubled-quote"},
        "header": {"type": "boolean"},
        "headerMatching": {"const": "exact"},
        "ignoreEmptyRecords": {"type": "boolean"}
      }
    },
    "mappings": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "oldIdValues", "newIdValue", "metadataToUpdate"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "oldIdValues": {"$ref": "#/$defs/listValue"},
          "newIdValue": {"$ref": "#/$defs/scalarValue"},
          "metadataToUpdate": {"$ref": "#/$defs/propertyValue"}
        }
      }
    }
  },
  "$defs": {
    "scalarSource": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "constant": {"type": "string"}
      }
    },
    "listSource": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "constant": {"type": "string"},
        "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "indexes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "transforms": {"type": "array", "items": {"enum": ["trim", "uppercase", "lowercase"]}},
    "scalarValue": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {"source": {"$ref": "#/$defs/scalarSource"}, "transforms": {"$ref": "#/$defs/transforms"}}
    },
    "listValue": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {
        "source": {"$ref": "#/$defs/listSource"},
        "transforms": {"$ref": "#/$defs/transforms"},
        "dropEmpty": {"type": "boolean"},
        "distinct": {"type": "boolean"},
        "split": {
          "type": "object", "additionalProperties": false, "required": ["delimiter", "mode"],
          "properties": {"delimiter": {"type": "string", "minLength": 1}, "mode": {"const": "literal"}}
        }
      }
    },
    "propertyValue": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "dependentRequired": {"valueMap": ["onUnmapped"], "onUnmapped": ["valueMap"]},
      "properties": {
        "source": {"$ref": "#/$defs/scalarSource"},
        "transforms": {"$ref": "#/$defs/transforms"},
        "valueMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "onUnmapped": {"const": "error"}
      }
    }
  }
}
